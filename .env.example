# ─── Supabase keys ─────────────────────────────────────────────────────────
# 1. Copy this file and name the copy:  .env
# 2. In the Supabase dashboard go to: Project Settings → API Keys
# 3. Paste the Project URL and the PUBLISHABLE key (sb_publishable_...;
#    on older dashboards it is labelled "anon / public").
#    NEVER the secret / service_role key.
# 4. Check it:  npm run check:db
#
# .env is gitignored; never commit it. The publishable key is safe to ship in
# the APK because Row Level Security protects the data, but the secret key
# bypasses all security and must NEVER appear in this app.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
