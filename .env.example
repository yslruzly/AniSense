# ─── Supabase keys ─────────────────────────────────────────────────────────
# 1. Copy this file and rename the copy to:  .env
# 2. In the Supabase dashboard go to: Project Settings → API
# 3. Paste the values below (the "anon / public" key, NOT the service_role key!)
#
# .env is gitignored; never commit it. The anon key is safe to ship in the
# APK because Row Level Security protects the data, but the service_role key
# bypasses all security and must NEVER appear in this app.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
