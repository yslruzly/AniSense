<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Status bar starts ink because the first screen behind it is ink.
             lib/platform.ts takes over per screen once the webview is up. -->
        <item name="android:statusBarColor">@color/anisenseInk</item>
        <item name="android:navigationBarColor">@color/anisensePaper</item>
    </style>

    <!-- Launch theme. On Android 12+ the system draws this and there is no way
         to opt out, so it must match the first frame of the app exactly. The
         icon is the logo mark on the ink background; postSplashScreenTheme is
         what the window becomes the instant the splash is dismissed. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/anisenseInk</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
